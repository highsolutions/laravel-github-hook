{
    "name": "highsolutions/github-hook",
    "description": "A Laravel package for simple Continuous Integration based on GitHub push.",
    "keywords": ["laravel", "github", "continuous", "integration", "ci", "git", "hook"],
    "authors": [
        {
            "name": "HighSolutions",
            "email": "adam@highsolutions.pl"
        }
    ],
    "license": "MIT",
    "require": {
        "php": ">=7.1.3|>=8.0.2",
        "illuminate/support": "5.*|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "laravel/slack-notification-channel":  "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "HighSolutions\\GitHubHook\\": "src/"
        }
    },
    "extra": {
        "component": "package",
        "frameworks": ["Laravel 5.6", "Laravel 5.7", "Laravel 5.8", "Laravel 6.x", "Laravel 7.x", "Laravel 8.x", "Laravel 9.x", "Laravel 10.x", , "Laravel 11.x"],
        "laravel": {
            "providers": [
                "HighSolutions\\GitHubHook\\GitHubHookServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
